    "check:live": "node scripts/live-check.mjs",
    "package": "bash scripts/package.sh",
    "screenshots": "node scripts/screenshots.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "puppeteer": "^25.13.0"
  }
}
